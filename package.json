{
  "name": "dispatchdeck",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.15.0 <23 || >=24 <25 || >=26 <27",
    "npm": ">=11.6.0"
  },
  "type": "module",
  "allowScripts": {
    "esbuild": true,
    "workerd": true
  },
  "scripts": {
    "dev": "deepspace dev start",
    "build": "vite build",
    "type-check": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json && tsc -p tests",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test tests/*.test.ts",
    "test:e2e": "node tests/dispatch.e2e.ts",
    "validate": "npm run format:check && npm run type-check && npm run lint && npm test",
    "deepspace": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/deepspace.ps1",
    "deploy": "npm run validate && npm run deepspace -- deploy --json"
  },
  "dependencies": {
    "ai": "7.0.107",
    "clsx": "^2.1.0",
    "deepspace": "0.44.1",
    "hono": "^4.13.7",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.33.0",
    "@cloudflare/workers-types": "^5.20260708.1",
    "@playwright/test": "^1.50.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "24.10.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "3.6.2",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.0",
    "vite-plugin-checker": "^0.14.1",
    "wrangler": "^4.79.0"
  },
  "private": true
}
